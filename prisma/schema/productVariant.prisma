model ProductVariant {
    id        String @id @default(uuid())
    productId String

    name    String
    sku     String? @unique

    price          Decimal  @db.Decimal(10, 2)
    compareAtPrice Decimal? @db.Decimal(10, 2)
    costPrice      Decimal? @db.Decimal(10, 2)

    stock             Int  @default(0)
    lowStockThreshold Int?

    isDefault Boolean       @default(false)
    status    VariantStatus @default(ACTIVE)

    weight Decimal? @db.Decimal(8, 3)
    length Decimal? @db.Decimal(8, 2)
    width  Decimal? @db.Decimal(8, 2)
    height Decimal? @db.Decimal(8, 2)

    imageId String?
    image   Asset?  @relation(fields: [imageId], references: [id])

    product Product @relation(fields: [productId], references: [id])

    attributes VariantAttributeValue[]
    reviews Review[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([productId])
    @@index([sku])
    @@index([status])
    @@index([stock])
    @@index([productId, status])
    @@map("product_variants")
}

model VariantAttributeValue {
    id String @id @default(uuid())

    variantId String
    variant   ProductVariant @relation(fields: [variantId], references: [id])

    attributeId String
    attribute   Attribute @relation(fields: [attributeId], references: [id])

    optionId String?
    option   AttributeOption? @relation(fields: [optionId], references: [id])

    value String?

    @@unique([variantId, attributeId])
    @@index([variantId])
    @@index([attributeId])
    @@index([optionId])
    @@index([attributeId, optionId])
    @@map("variant_attribute_values")
}
